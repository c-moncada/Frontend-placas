# Copia este archivo como .env.local (no se sube a git) y pon tus valores.
# Ojo: todo lo que empieza con EXPO_PUBLIC_ queda visible dentro de la app.

# URL de la API, sin / al final
EXPO_PUBLIC_API_URL=https://alpr-api-9w5h.onrender.com
# El valor de API_KEY en Render (Environment)
EXPO_PUBLIC_API_KEY=

# En Vercel (versión web) la key NO va en EXPO_PUBLIC_API_KEY. Configura allí:
#   EXPO_PUBLIC_API_URL=/api          (el navegador llama al proxy de api/proxy.ts)
#   API_URL=https://alpr-api-9w5h.onrender.com
#   API_KEY=<la key>                  (solo la lee el servidor)
