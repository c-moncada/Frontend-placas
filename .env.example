# Copia este archivo como .env.local (no se sube a git) y pon tus valores.
# Ojo: todo lo que empieza con EXPO_PUBLIC_ queda visible dentro de la app.

# La app (web y APK) llama al proxy de Vercel (api/proxy.ts), que agrega la key.
# Web en Vercel: /api    APK o desarrollo local: https://<proyecto>.vercel.app/api
EXPO_PUBLIC_API_URL=https://<proyecto>.vercel.app/api

# Solo para desarrollo contra Render directo (sin proxy): pon la URL de Render
# arriba y la key aquí. Nunca la configures en Vercel, EAS ni GitHub.
EXPO_PUBLIC_API_KEY=

# Variables del servidor en Vercel (no llevan EXPO_PUBLIC_):
#   API_URL=https://alpr-api-9w5h.onrender.com
#   API_KEY=<la key>
